# ===== Smart Student Assistance Portal — root env (copy to backend/.env) =====
# The backend reads env from backend/.env (see backend/.env.example).
# This root file is a convenient reference for local full-stack runs.

# Frontend reads API base URL at runtime. Default (localhost):
VITE_API_URL=http://localhost:5000

# Backend (copy these into backend/.env)
MONGO_URI=mongodb://127.0.0.1:27017/ssap
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
CORS_ORIGIN=http://localhost:3000
