# ===== Smart Student Assistance Portal - Backend env =====
NODE_ENV=development
PORT=5000

# MongoDB Atlas or local
MONGO_URI=mongodb://127.0.0.1:27017/ssap

# Auth
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_SECURE=false

# CORS (frontend origin, comma separated for multiple)
CORS_ORIGIN=http://localhost:3000

# AI (optional - rule based engine used if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloudinary (optional - local disk storage used if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional - in-app notifications used if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ssap.in

# Cron deadline reminders (set false to disable)
CRON_ENABLED=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
